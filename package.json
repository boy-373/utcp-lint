{
  "name": "utcp-lint",
  "version": "0.1.1",
  "description": "Static analysis for CVE-2026-45366 and CVE-2026-101060: catch SSRF, credential leaks and manual-schema errors in UTCP manuals, MCP configs and OpenAPI specs before they reach CI.",
  "type": "module",
  "bin": {
    "utcp-lint": "./bin/utcp-lint.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint:self": "node ./bin/utcp-lint.js test/fixtures"
  },
  "keywords": [
    "utcp",
    "mcp",
    "a2a",
    "lint",
    "security",
    "ssrf",
    "openapi",
    "agent",
    "ci",
    "static-analysis",
    "cve-2026-45366",
    "cve-2026-101060",
    "ssrf-detection",
    "cve",
    "security-scanner"
  ],
  "license": "Apache-2.0",
  "author": "Mycel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boy-373/utcp-lint.git"
  },
  "bugs": {
    "url": "https://github.com/boy-373/utcp-lint/issues"
  },
  "homepage": "https://github.com/boy-373/utcp-lint#readme"
}
